@@ -0,0 +1,97 @@
+"""Tests for the JSRF-specific MMIO rewrite."""
+
+import unittest
+
+from tools.recomp.mmio_rewrite import rewrite, rewrite_generated_source
+
+
+class MmioRewriteTests(unittest.TestCase):
+    def test_read_and_signed_read(self):
+        self.assertEqual(
+            rewrite("eax = MEM32(esi + 0x10);"),
+            "eax = MMIO_RD32(esi + 0x10);",
+        )
+        self.assertEqual(
+            rewrite("eax = (uint32_t)SMEM16(ecx);"),
+            "eax = (uint32_t)((int16_t)MMIO_RD16(ecx));",
+        )
+
+    def test_plain_and_compound_stores(self):
+        self.assertEqual(
+            rewrite("MEM8(eax + 4) = 2;"),
+            "MMIO_WR8(eax + 4, (2));",
+        )
+        self.assertEqual(
+            rewrite("MEM32(ebp + -4) &= 0;"),
+            "MMIO_WR32(ebp + -4, MMIO_RD32(ebp + -4) & (0));",
+        )
+
+    def test_watch_store_preserves_guest_site_and_rewrites_value(self):
+        source = (
+            "RECOMP_MEM_WRITE32(0x001BC000u, 0x001BC000u, eax, MEM32(ecx));"
+        )
+        self.assertEqual(
+            rewrite(source),
+            "RECOMP_MMIO_MEM_WRITE32(0x001BC000u, 0x001BC000u, "
+            "eax, MMIO_RD32(ecx));",
+        )
+
+    def test_small_width_watch_stores_are_routed(self):
+        for width in ("8", "16"):
+            source = f"RECOMP_MEM_WRITE{width}(pc, fn, eax, value);"
+            self.assertEqual(
+                rewrite(source),
+                f"RECOMP_MMIO_MEM_WRITE{width}(pc, fn, eax, value);",
+            )
+
+    def test_float_and_double_watch_stores_are_routed(self):
+        self.assertEqual(
+            rewrite("RECOMP_MEM_WRITEF(pc, fn, eax, fp_top());"),
+            "RECOMP_MMIO_MEM_WRITEF(pc, fn, eax, fp_top());",
+        )
+        self.assertEqual(
+            rewrite("RECOMP_MEM_WRITED(pc, fn, eax, fp_top());"),
+            "RECOMP_MMIO_MEM_WRITED(pc, fn, eax, fp_top());",
+        )
+        self.assertEqual(
+            rewrite("RECOMP_MEM_WRITE64(pc, fn, eax, value);"),
+            "RECOMP_MMIO_MEM_WRITE64(pc, fn, eax, value);",
+        )
+
+    def test_nested_commas_and_memory_accesses_in_store_arguments(self):
+        source = "RECOMP_MEM_WRITE32(pc, fn, eax, combine(a, b) + MEM16(ecx));"
+        self.assertEqual(
+            rewrite(source),
+            "RECOMP_MMIO_MEM_WRITE32(pc, fn, eax, "
+            "combine(a, b) + MMIO_RD16(ecx));",
+        )
+
+    def test_rewrite_is_idempotent(self):
+        source = (
+            "eax = MEM32(ebx); "
+            "RECOMP_MEM_WRITE32(pc, fn, eax, MEM16(ecx));"
+        )
+        once = rewrite(source)
+        self.assertEqual(rewrite(once), once)
+
+    def test_only_selected_section_functions_are_rewritten(self):
+        source = (
+            "void sub_00100000(void)\n{\n"
+            "    eax = MEM32(ebx);\n"
+            "}\n"
+            "void sub_001BC000(void)\n{\n"
+            "    RECOMP_MEM_WRITE32(pc, fn, eax, edx);\n"
+            "}\n"
+        )
+        rewritten, selected, changed = rewrite_generated_source(
+            source, [(0x001BC000, 0x001C0000)]
+        )
+        self.assertIn("eax = MEM32(ebx);", rewritten)
+        self.assertIn(
+            "RECOMP_MMIO_MEM_WRITE32(pc, fn, eax, edx);", rewritten
+        )
+        self.assertEqual((selected, changed), (1, 1))
+
+
+if __name__ == "__main__":
+    unittest.main()
