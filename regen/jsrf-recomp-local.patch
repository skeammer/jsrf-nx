diff --git a/tools/recomp/mmio_rewrite.py b/tools/recomp/mmio_rewrite.py
new file mode 100644
index 0000000..fdee226
--- /dev/null
+++ b/tools/recomp/mmio_rewrite.py
@@ -0,0 +1,343 @@
+"""Rewrite generated DSOUND/XPP accesses through the runtime MMIO model."""
+
+import argparse
+import re
+from pathlib import Path
+
+from . import config
+
+
+_ACCESS = re.compile(r"(?<![A-Za-z0-9_])(S?)MEM(8|16|32)\(")
+_ASSIGN = re.compile(r"\s*(<<=|>>=|\+=|-=|\*=|/=|%=|&=|\|=|\^=|=(?!=))")
+_STORE = re.compile(
+    r"(?<![A-Za-z0-9_])RECOMP_MEM_WRITE(8|16|32|64|F|D)\s*\("
+)
+_FUNCTION = re.compile(
+    r"(?m)^void\s+sub_([0-9A-Fa-f]{8})\s*\(\s*void\s*\)\s*\{"
+)
+_SIGNED = {"8": "int8_t", "16": "int16_t", "32": "int32_t"}
+
+
+def _matching_delimiter(text, start):
+    """Index just past the matching delimiter at ``start``."""
+    pairs = {"(": ")", "{": "}", "[": "]"}
+    opening = text[start]
+    if opening not in pairs:
+        raise ValueError(f"expected an opening delimiter at offset {start}")
+
+    depth = 0
+    quote = None
+    line_comment = False
+    block_comment = False
+    escaped = False
+    i = start
+    while i < len(text):
+        char = text[i]
+        following = text[i + 1] if i + 1 < len(text) else ""
+
+        if line_comment:
+            if char == "\n":
+                line_comment = False
+        elif block_comment:
+            if char == "*" and following == "/":
+                block_comment = False
+                i += 1
+        elif quote:
+            if escaped:
+                escaped = False
+            elif char == "\\":
+                escaped = True
+            elif char == quote:
+                quote = None
+        elif char == "/" and following == "/":
+            line_comment = True
+            i += 1
+        elif char == "/" and following == "*":
+            block_comment = True
+            i += 1
+        elif char in ('"', "'"):
+            quote = char
+        elif char == opening:
+            depth += 1
+        elif char == pairs[opening]:
+            depth -= 1
+            if depth == 0:
+                return i + 1
+        i += 1
+
+    raise ValueError(f"unbalanced {opening!r} in generated code")
+
+
+def _split_arguments(text):
+    """Split call arguments on commas outside nested expressions or comments."""
+    arguments = []
+    start = 0
+    stack = []
+    quote = None
+    line_comment = False
+    block_comment = False
+    escaped = False
+    pairs = {")": "(", "]": "[", "}": "{"}
+    i = 0
+
+    while i < len(text):
+        char = text[i]
+        following = text[i + 1] if i + 1 < len(text) else ""
+
+        if line_comment:
+            if char == "\n":
+                line_comment = False
+        elif block_comment:
+            if char == "*" and following == "/":
+                block_comment = False
+                i += 1
+        elif quote:
+            if escaped:
+                escaped = False
+            elif char == "\\":
+                escaped = True
+            elif char == quote:
+                quote = None
+        elif char == "/" and following == "/":
+            line_comment = True
+            i += 1
+        elif char == "/" and following == "*":
+            block_comment = True
+            i += 1
+        elif char in ('"', "'"):
+            quote = char
+        elif char in "([{":
+            stack.append(char)
+        elif char in ")]}":
+            if not stack or stack.pop() != pairs[char]:
+                raise ValueError("unbalanced delimiters in MMIO store arguments")
+        elif char == "," and not stack:
+            arguments.append(text[start:i].strip())
+            start = i + 1
+        i += 1
+
+    if stack or quote or block_comment:
+        raise ValueError("unterminated expression in MMIO store arguments")
+    last = text[start:].strip()
+    if last or arguments:
+        arguments.append(last)
+    return arguments
+
+
+def _statement_end(text, start):
+    """Index of the semicolon ending the expression that starts at ``start``."""
+    depth = 0
+    quote = None
+    line_comment = False
+    block_comment = False
+    escaped = False
+    i = start
+    while i < len(text):
+        char = text[i]
+        following = text[i + 1] if i + 1 < len(text) else ""
+
+        if line_comment:
+            if char == "\n":
+                line_comment = False
+        elif block_comment:
+            if char == "*" and following == "/":
+                block_comment = False
+                i += 1
+        elif quote:
+            if escaped:
+                escaped = False
+            elif char == "\\":
+                escaped = True
+            elif char == quote:
+                quote = None
+        elif char == "/" and following == "/":
+            line_comment = True
+            i += 1
+        elif char == "/" and following == "*":
+            block_comment = True
+            i += 1
+        elif char in ('"', "'"):
+            quote = char
+        elif char in "([{":
+            depth += 1
+        elif char in ")]}":
+            depth -= 1
+        elif char == ";" and depth == 0:
+            return i
+        i += 1
+
+    raise ValueError("unterminated statement in generated code")
+
+
+def _rewrite_store_calls(code):
+    out = []
+    pos = 0
+    while True:
+        match = _STORE.search(code, pos)
+        if not match:
+            out.append(code[pos:])
+            return "".join(out)
+
+        out.append(code[pos:match.start()])
+        close = _matching_delimiter(code, match.end() - 1)
+        arguments = _split_arguments(code[match.end():close - 1])
+        if len(arguments) != 4:
+            raise ValueError(
+                f"{match.group(0)[:-1]} expects 4 arguments, got {len(arguments)}"
+            )
+        arguments = [rewrite(argument) for argument in arguments]
+        out.append(
+            f"RECOMP_MMIO_MEM_WRITE{match.group(1)}("
+            + ", ".join(arguments)
+            + ")"
+        )
+        pos = close
+
+
+def _rewrite_memory_accesses(code):
+    out = []
+    pos = 0
+    while True:
+        match = _ACCESS.search(code, pos)
+        if not match:
+            out.append(code[pos:])
+            return "".join(out)
+
+        out.append(code[pos:match.start()])
+        signed, bits = match.group(1), match.group(2)
+        close = _matching_delimiter(code, match.end() - 1)
+        address = rewrite(code[match.end():close - 1])
+        assignment = _ASSIGN.match(code, close)
+        if assignment:
+            operator = assignment.group(1)
+            end = _statement_end(code, assignment.end())
+            value = rewrite(code[assignment.end():end].strip())
+            current = f"MMIO_RD{bits}({address})"
+            if signed:
+                current = f"(({_SIGNED[bits]}){current})"
+            if operator == "=":
+                out.append(f"MMIO_WR{bits}({address}, ({value}))")
+            else:
+                out.append(
+                    f"MMIO_WR{bits}({address}, "
+                    f"{current} {operator[:-1]} ({value}))"
+                )
+            pos = end
+            continue
+
+        read = f"MMIO_RD{bits}({address})"
+        if signed:
+            read = f"(({_SIGNED[bits]}){read})"
+        out.append(read)
+        pos = close
+
+
+def rewrite(code):
+    """Rewrite raw accesses and memory-watch stores in one generated function."""
+    return _rewrite_memory_accesses(_rewrite_store_calls(code))
+
+
+def _function_end(source, open_brace):
+    return _matching_delimiter(source, open_brace)
+
+
+def rewrite_generated_source(source, section_ranges):
+    """Rewrite only function definitions whose start VA belongs to a section."""
+    out = []
+    pos = 0
+    selected = 0
+    changed = 0
+    for match in _FUNCTION.finditer(source):
+        if match.start() < pos:
+            continue
+        address = int(match.group(1), 16)
+        if not any(start <= address < end for start, end in section_ranges):
+            continue
+
+        end = _function_end(source, match.end() - 1)
+        original = source[match.start():end]
+        rewritten = rewrite(original)
+        out.append(source[pos:match.start()])
+        out.append(rewritten)
+        pos = end
+        selected += 1
+        changed += rewritten != original
+
+    out.append(source[pos:])
+    return "".join(out), selected, changed
+
+
+def rewrite_generated_dir(gen_dir, section_ranges):
+    """Apply the section rewrite to generated C files, including recovered stubs."""
+    root = Path(gen_dir)
+    paths = sorted(root.glob("recomp_*.c"))
+    if not paths:
+        raise ValueError(f"no recomp_*.c files found in {root}")
+
+    files_changed = 0
+    functions_selected = 0
+    functions_changed = 0
+    for path in paths:
+        original = path.read_text()
+        rewritten, selected, changed = rewrite_generated_source(
+            original, section_ranges
+        )
+        functions_selected += selected
+        functions_changed += changed
+        if rewritten != original:
+            path.write_text(rewritten)
+            files_changed += 1
+
+    if not functions_selected:
+        raise ValueError(
+            f"no generated functions found in requested sections under {root}"
+        )
+    return files_changed, functions_selected, functions_changed
+
+
+def _section_ranges(names):
+    sections = {
+        name: (start, start + size)
+        for name, start, size, _raw_addr in config.SECTIONS
+    }
+    missing = [name for name in names if name not in sections]
+    if missing:
+        raise ValueError(
+            "XBE does not contain requested section(s): " + ", ".join(missing)
+        )
+    return [sections[name] for name in names]
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--xbe", required=True, help="XBE used for section ranges")
+    parser.add_argument("--gen-dir", required=True, help="generated C directory")
+    parser.add_argument(
+        "--mmio-sections",
+        required=True,
+        help="comma-separated XBE section names, for example DSOUND,XPP",
+    )
+    args = parser.parse_args(argv)
+    names = list(dict.fromkeys(
+        name.strip() for name in args.mmio_sections.split(",") if name.strip()
+    ))
+    if not names:
+        parser.error("--mmio-sections must name at least one section")
+
+    try:
+        config.configure_from_xbe(args.xbe)
+        ranges = _section_ranges(names)
+        files, selected, changed = rewrite_generated_dir(args.gen_dir, ranges)
+    except (OSError, ValueError) as exc:
+        parser.error(str(exc))
+
+    print(
+        "MMIO rewrite "
+        f"{','.join(names)}: selected {selected} functions, modified "
+        f"{changed} across {files} file(s)"
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
